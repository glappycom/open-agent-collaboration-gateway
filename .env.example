OPENAI_API_KEY=
XAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
XAI_MODEL=grok-4.6

# Optional cost rates in USD per 1M tokens. Leave 0 when unknown.
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0
XAI_INPUT_COST_PER_MILLION=0
XAI_OUTPUT_COST_PER_MILLION=0

DATABASE_PATH=./gateway.db

MAX_TURNS=6
MAX_CONTEXT_CHARS=24000
MAX_PROMPT_CHARS=32000
MAX_PROVIDER_CALLS_PER_REQUEST=7
MAX_REQUESTS_PER_MINUTE=60

APPROVAL_RISK_LEVEL=high
PROVIDER_STORE_RESPONSES=false
PROVIDER_TIMEOUT_SECONDS=45
MAX_PROVIDER_OUTPUT_CHARS=64000
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BACKOFF_SECONDS=0.25
CIRCUIT_BREAKER_FAILURES=3
CIRCUIT_BREAKER_RESET_SECONDS=30

# Optional. Leave blank for local development. Set a strong random value before public deployment.
OACG_ACCESS_TOKEN=

IDEMPOTENCY_TTL_SECONDS=86400
